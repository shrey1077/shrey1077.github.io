# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# scratch / session recordings (root-level only, not public/videos/)
/video-background-remover.webm

# raw source material — ~10 GB of client archives and folio masters, consolidated
# here 2026-08-21 so the whole project lives under one root. Read by the
# prepare-* pipelines via scripts/sources.mjs; never tracked, never exported.
# ⚠ Not a cache: _source/BWP/_masters/brain-alpha.webm is the ONLY copy of the
# master the hero brain frames are generated from. Do not delete this tree.
/_source/
